    "import:secrets": "node scripts/import-secrets.mjs"
  },
  "dependencies": {
    "@siwc/local": "file:vendor/siwc-local",
    "jose": "^6.1.0",
    "openai": "^7.21.0",
    "proper-lockfile": "^4.1.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "^1.31.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/proper-lockfile": "^4.1.4",
    "vite": "8.0.13",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/node": "22.19.19"
  },
