{
  "name": "suanli-ai-chat",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build:sdk": "tsc -p vendor/siwc-local/tsconfig.json",
    "build": "npm run build:sdk && tsc --noEmit && vite build",
    "start": "node scripts/start.mjs",
